{
  "name": "vscode-exercices-mpi",
  "displayName": "Exercices Typst",
  "icon": "media/icon-sidebar.png",
  "description": "Parcourir une banque d'exercices Typst, composer des feuilles et prévisualiser les énoncés et corrigés.",
  "version": "0.5.9",
  "publisher": "qfortier",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:scripts/catalogue.py"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "La compilation exécute les outils de la banque."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "exercicesMpi.addCurrent",
        "title": "Ajouter à la feuille en cours",
        "category": "Exercices Typst",
        "icon": "$(add)"
      },
      {
        "command": "exercicesMpi.memberUp",
        "title": "Monter dans la feuille",
        "category": "Exercices Typst",
        "icon": "$(arrow-up)"
      },
      {
        "command": "exercicesMpi.memberDown",
        "title": "Descendre dans la feuille",
        "category": "Exercices Typst",
        "icon": "$(arrow-down)"
      },
      {
        "command": "exercicesMpi.memberRemove",
        "title": "Retirer de la feuille",
        "category": "Exercices Typst",
        "icon": "$(close)"
      },
      {
        "command": "exercicesMpi.deleteSource",
        "title": "Supprimer le fichier…",
        "category": "Exercices Typst",
        "icon": "$(trash)"
      },
      {
        "command": "exercicesMpi.newFolderLibrary",
        "title": "Ajouter un dossier d'exercices",
        "category": "Exercices Typst",
        "icon": "$(new-folder)"
      },
      {
        "command": "exercicesMpi.newFolderSheets",
        "title": "Ajouter un dossier de feuilles",
        "category": "Exercices Typst",
        "icon": "$(new-folder)"
      },
      {
        "command": "exercicesMpi.newFolderContests",
        "title": "Ajouter un dossier de concours",
        "category": "Exercices Typst",
        "icon": "$(new-folder)"
      },
      {
        "command": "exercicesMpi.searchSheets",
        "title": "Rechercher des feuilles",
        "category": "Exercices Typst",
        "icon": "$(search)"
      },
      {
        "command": "exercicesMpi.filtersSheets",
        "title": "Filtrer les feuilles",
        "category": "Exercices Typst",
        "icon": "$(filter)"
      },
      {
        "command": "exercicesMpi.resetSheets",
        "title": "Annuler la recherche et les filtres",
        "category": "Exercices Typst",
        "icon": "$(close)"
      },
      {
        "command": "exercicesMpi.searchContests",
        "title": "Rechercher des concours",
        "category": "Exercices Typst",
        "icon": "$(search)"
      },
      {
        "command": "exercicesMpi.filtersContests",
        "title": "Filtrer les concours",
        "category": "Exercices Typst",
        "icon": "$(filter)"
      },
      {
        "command": "exercicesMpi.resetContests",
        "title": "Annuler la recherche et les filtres",
        "category": "Exercices Typst",
        "icon": "$(close)"
      },
      {
        "command": "exercicesMpi.newExercise",
        "title": "Ajouter un exercice",
        "category": "Exercices Typst",
        "icon": "$(new-file)"
      },
      {
        "command": "exercicesMpi.newSheet",
        "title": "Créer une nouvelle feuille",
        "category": "Exercices Typst",
        "icon": "$(file-add)"
      },
      {
        "command": "exercicesMpi.toggleLibrary",
        "title": "Basculer dossiers / liste",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.toggleSheets",
        "title": "Basculer dossiers / liste des feuilles",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.toggleContests",
        "title": "Basculer dossiers / liste des concours",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.search",
        "title": "Rechercher des exercices",
        "category": "Exercices Typst",
        "icon": "$(search)"
      },
      {
        "command": "exercicesMpi.filters",
        "title": "Filtrer les exercices",
        "category": "Exercices Typst",
        "icon": "$(filter)"
      },
      {
        "command": "exercicesMpi.reset",
        "title": "Annuler la recherche et les filtres",
        "category": "Exercices Typst",
        "icon": "$(close)"
      },
      {
        "command": "exercicesMpi.refresh",
        "title": "Régénérer le catalogue",
        "category": "Exercices Typst",
        "icon": "$(refresh)"
      },
      {
        "command": "exercicesMpi.source",
        "title": "Afficher le fichier",
        "category": "Exercices Typst",
        "icon": "$(go-to-file)"
      },
      {
        "command": "exercicesMpi.enonce",
        "title": "Compiler et afficher l'énoncé",
        "category": "Exercices Typst",
        "icon": {
          "light": "media/preview-light.svg",
          "dark": "media/preview-dark.svg"
        }
      },
      {
        "command": "exercicesMpi.corrige",
        "title": "Compiler et afficher le corrigé",
        "category": "Exercices Typst",
        "icon": {
          "light": "media/preview-corrected.svg",
          "dark": "media/preview-corrected.svg"
        }
      },
      {
        "command": "exercicesMpi.compileBoth",
        "title": "Exporter les PDF énoncé et corrigé (make c)",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.sync",
        "title": "Rejoindre le curseur dans l'aperçu",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.output",
        "title": "Afficher le journal de compilation",
        "category": "Exercices Typst",
        "icon": "$(output)"
      },
      {
        "command": "exercicesMpi.newContest",
        "title": "Créer un sujet de concours",
        "category": "Exercices Typst",
        "icon": "$(new-file)"
      },
      {
        "command": "exercicesMpi.openPanel",
        "title": "Ouvrir le panneau Exercices Typst",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.collapsecurrent",
        "title": "Tout replier",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.collapselibrary",
        "title": "Tout replier",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.collapsesheets",
        "title": "Tout replier",
        "category": "Exercices Typst"
      },
      {
        "command": "exercicesMpi.collapsecontests",
        "title": "Tout replier",
        "category": "Exercices Typst"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "exercicesMpi",
          "title": "Exercices Typst",
          "icon": "media/library.svg"
        }
      ]
    },
    "views": {
      "exercicesMpi": [
        {
          "id": "exercicesMpi.current",
          "name": "Fichier actuel"
        },
        {
          "id": "exercicesMpi.library",
          "name": "Exercices"
        },
        {
          "id": "exercicesMpi.sheets",
          "name": "Feuilles"
        },
        {
          "id": "exercicesMpi.contests",
          "name": "Concours"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "exercicesMpi.current",
        "contents": "Ouvrez un fichier Typst pour afficher son plan."
      },
      {
        "view": "exercicesMpi.library",
        "contents": "Ouvrez une banque exercices-mpi.\n[Régénérer le catalogue](command:exercicesMpi.refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "exercicesMpi.newFolderLibrary",
          "when": "view == exercicesMpi.library",
          "group": "navigation@5"
        },
        {
          "command": "exercicesMpi.newFolderSheets",
          "when": "view == exercicesMpi.sheets",
          "group": "navigation@5"
        },
        {
          "command": "exercicesMpi.newFolderContests",
          "when": "view == exercicesMpi.contests",
          "group": "navigation@5"
        },
        {
          "command": "exercicesMpi.searchSheets",
          "when": "view == exercicesMpi.sheets",
          "group": "navigation@1"
        },
        {
          "command": "exercicesMpi.filtersSheets",
          "when": "view == exercicesMpi.sheets",
          "group": "navigation@2"
        },
        {
          "command": "exercicesMpi.resetSheets",
          "when": "view == exercicesMpi.sheets && exercicesMpi.searchActive.sheets",
          "group": "navigation@3"
        },
        {
          "command": "exercicesMpi.searchContests",
          "when": "view == exercicesMpi.contests",
          "group": "navigation@1"
        },
        {
          "command": "exercicesMpi.filtersContests",
          "when": "view == exercicesMpi.contests",
          "group": "navigation@2"
        },
        {
          "command": "exercicesMpi.resetContests",
          "when": "view == exercicesMpi.contests && exercicesMpi.searchActive.contests",
          "group": "navigation@3"
        },
        {
          "command": "exercicesMpi.search",
          "when": "view == exercicesMpi.library",
          "group": "navigation@1"
        },
        {
          "command": "exercicesMpi.filters",
          "when": "view == exercicesMpi.library",
          "group": "navigation@2"
        },
        {
          "command": "exercicesMpi.toggleLibrary",
          "when": "view == exercicesMpi.library",
          "group": "display@2"
        },
        {
          "command": "exercicesMpi.newExercise",
          "when": "view == exercicesMpi.library",
          "group": "navigation@4"
        },
        {
          "command": "exercicesMpi.refresh",
          "when": "view == exercicesMpi.library"
        },
        {
          "command": "exercicesMpi.reset",
          "when": "view == exercicesMpi.library && exercicesMpi.searchActive.library",
          "group": "navigation@3"
        },
        {
          "command": "exercicesMpi.output",
          "when": "view == exercicesMpi.library"
        },
        {
          "command": "exercicesMpi.newSheet",
          "when": "view == exercicesMpi.sheets",
          "group": "navigation@4"
        },
        {
          "command": "exercicesMpi.toggleSheets",
          "when": "view == exercicesMpi.sheets",
          "group": "display@2"
        },
        {
          "command": "exercicesMpi.toggleContests",
          "when": "view == exercicesMpi.contests",
          "group": "display@2"
        },
        {
          "command": "exercicesMpi.newContest",
          "when": "view == exercicesMpi.contests",
          "group": "navigation@4"
        },
        {
          "command": "exercicesMpi.collapsecurrent",
          "when": "view == exercicesMpi.current",
          "group": "display@1"
        },
        {
          "command": "exercicesMpi.collapselibrary",
          "when": "view == exercicesMpi.library",
          "group": "display@1"
        },
        {
          "command": "exercicesMpi.collapsesheets",
          "when": "view == exercicesMpi.sheets",
          "group": "display@1"
        },
        {
          "command": "exercicesMpi.collapsecontests",
          "when": "view == exercicesMpi.contests",
          "group": "display@1"
        }
      ],
      "view/item/context": [
        {
          "command": "exercicesMpi.addCurrent",
          "when": "viewItem == exercice",
          "group": "inline@3"
        },
        {
          "command": "exercicesMpi.addCurrent",
          "when": "viewItem == exercice",
          "group": "selection@1"
        },
        {
          "command": "exercicesMpi.memberUp",
          "when": "viewItem == sheetMember",
          "group": "inline@1"
        },
        {
          "command": "exercicesMpi.memberDown",
          "when": "viewItem == sheetMember",
          "group": "inline@2"
        },
        {
          "command": "exercicesMpi.memberRemove",
          "when": "viewItem == sheetMember",
          "group": "inline@3"
        },
        {
          "command": "exercicesMpi.memberUp",
          "when": "viewItem == sheetMember",
          "group": "composition@1"
        },
        {
          "command": "exercicesMpi.memberDown",
          "when": "viewItem == sheetMember",
          "group": "composition@2"
        },
        {
          "command": "exercicesMpi.memberRemove",
          "when": "viewItem == sheetMember",
          "group": "composition@3"
        },
        {
          "command": "exercicesMpi.deleteSource",
          "when": "viewItem == exercice || viewItem == typstSource",
          "group": "files@2"
        },
        {
          "command": "exercicesMpi.newExercise",
          "when": "view == exercicesMpi.library && viewItem == sourceFolder",
          "group": "files@1"
        },
        {
          "command": "exercicesMpi.newFolderLibrary",
          "when": "view == exercicesMpi.library && viewItem == sourceFolder",
          "group": "files@2"
        },
        {
          "command": "exercicesMpi.newFolderSheets",
          "when": "view == exercicesMpi.sheets && viewItem == sourceFolder",
          "group": "files@2"
        },
        {
          "command": "exercicesMpi.newFolderContests",
          "when": "view == exercicesMpi.contests && viewItem == sourceFolder",
          "group": "files@2"
        },
        {
          "command": "exercicesMpi.enonce",
          "when": "viewItem == exercice || viewItem == typstSource",
          "group": "inline@1"
        },
        {
          "command": "exercicesMpi.corrige",
          "when": "viewItem == exercice || viewItem == typstSource",
          "group": "inline@2"
        },
        {
          "command": "exercicesMpi.newSheet",
          "when": "view == exercicesMpi.sheets && viewItem == sourceFolder",
          "group": "files@1"
        },
        {
          "command": "exercicesMpi.newContest",
          "when": "view == exercicesMpi.contests && viewItem == sourceFolder",
          "group": "files@1"
        }
      ],
      "editor/title": [
        {
          "command": "exercicesMpi.enonce",
          "when": "resourceExtname == .typ",
          "group": "navigation@8"
        },
        {
          "command": "exercicesMpi.corrige",
          "when": "resourceExtname == .typ",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "exercicesMpi.enonce",
          "when": "resourceExtname == .typ",
          "group": "exercicesMpi@1"
        },
        {
          "command": "exercicesMpi.corrige",
          "when": "resourceExtname == .typ",
          "group": "exercicesMpi@2"
        }
      ],
      "commandPalette": [
        {
          "command": "exercicesMpi.addCurrent",
          "when": "false"
        },
        {
          "command": "exercicesMpi.memberUp",
          "when": "false"
        },
        {
          "command": "exercicesMpi.memberDown",
          "when": "false"
        },
        {
          "command": "exercicesMpi.memberRemove",
          "when": "false"
        },
        {
          "command": "exercicesMpi.deleteSource",
          "when": "false"
        },
        {
          "command": "exercicesMpi.newFolderLibrary",
          "when": "false"
        },
        {
          "command": "exercicesMpi.newFolderSheets",
          "when": "false"
        },
        {
          "command": "exercicesMpi.newFolderContests",
          "when": "false"
        },
        {
          "command": "exercicesMpi.filtersSheets",
          "when": "false"
        },
        {
          "command": "exercicesMpi.resetSheets",
          "when": "false"
        },
        {
          "command": "exercicesMpi.filtersContests",
          "when": "false"
        },
        {
          "command": "exercicesMpi.resetContests",
          "when": "false"
        },
        {
          "command": "exercicesMpi.toggleLibrary",
          "when": "false"
        },
        {
          "command": "exercicesMpi.toggleSheets",
          "when": "false"
        },
        {
          "command": "exercicesMpi.toggleContests",
          "when": "false"
        },
        {
          "command": "exercicesMpi.reset",
          "when": "false"
        },
        {
          "command": "exercicesMpi.refresh",
          "when": "false"
        },
        {
          "command": "exercicesMpi.source",
          "when": "false"
        },
        {
          "command": "exercicesMpi.enonce",
          "when": "false"
        },
        {
          "command": "exercicesMpi.compileBoth",
          "when": "false"
        },
        {
          "command": "exercicesMpi.sync",
          "when": "false"
        },
        {
          "command": "exercicesMpi.output",
          "when": "false"
        },
        {
          "command": "exercicesMpi.newContest",
          "when": "false"
        },
        {
          "command": "exercicesMpi.collapsecurrent",
          "when": "false"
        },
        {
          "command": "exercicesMpi.collapselibrary",
          "when": "false"
        },
        {
          "command": "exercicesMpi.collapsesheets",
          "when": "false"
        },
        {
          "command": "exercicesMpi.collapsecontests",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Exercices Typst",
      "properties": {
        "exercicesMpi.previewTheme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Thème des pages : suivre VS Code, clair ou sombre. Les images conservent leurs couleurs."
        },
        "exercicesMpi.bankPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Chemin de la banque. Vide : racine du dossier ouvert."
        },
        "exercicesMpi.execution": {
          "type": "string",
          "enum": [
            "auto",
            "nix",
            "direct"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Pour les exports et le catalogue : auto utilise Nix si flake.nix existe, sinon Make."
        },
        "exercicesMpi.nixPath": {
          "type": "string",
          "default": "nix",
          "scope": "resource",
          "description": "Exécutable Nix ; les installations standard macOS sont détectées."
        },
        "exercicesMpi.makePath": {
          "type": "string",
          "default": "make",
          "scope": "resource",
          "description": "Exécutable Make dans l'environnement choisi."
        }
      }
    },
    "keybindings": [
      {
        "command": "exercicesMpi.corrige",
        "key": "f5",
        "when": "(editorTextFocus && resourceExtname == .typ) || (!inputFocus && focusedView =~ /^exercicesMpi\\./)"
      },
      {
        "command": "exercicesMpi.search",
        "key": "f2",
        "when": "(editorTextFocus && resourceExtname == .typ) || (!inputFocus && focusedView =~ /^exercicesMpi\\./)"
      },
      {
        "command": "exercicesMpi.searchSheets",
        "key": "f3",
        "when": "(editorTextFocus && resourceExtname == .typ) || (!inputFocus && focusedView =~ /^exercicesMpi\\./)"
      },
      {
        "command": "exercicesMpi.searchContests",
        "key": "f4",
        "when": "(editorTextFocus && resourceExtname == .typ) || (!inputFocus && focusedView =~ /^exercicesMpi\\./)"
      },
      {
        "command": "exercicesMpi.filters",
        "key": "shift+f2",
        "when": "(editorTextFocus && resourceExtname == .typ) || (!inputFocus && focusedView =~ /^exercicesMpi\\./)"
      },
      {
        "command": "exercicesMpi.newSheet",
        "key": "shift+f3",
        "when": "(editorTextFocus && resourceExtname == .typ) || (!inputFocus && focusedView =~ /^exercicesMpi\\./)"
      },
      {
        "command": "exercicesMpi.newExercise",
        "key": "shift+f4",
        "when": "(editorTextFocus && resourceExtname == .typ) || (!inputFocus && focusedView =~ /^exercicesMpi\\./)"
      },
      {
        "command": "exercicesMpi.openPanel",
        "key": "shift+f5",
        "when": "(editorTextFocus && resourceExtname == .typ) || (!inputFocus && focusedView =~ /^exercicesMpi\\./)"
      },
      {
        "command": "exercicesMpi.reset",
        "key": "escape",
        "when": "focusedView == exercicesMpi.library && exercicesMpi.searchActive.library && !inputFocus"
      },
      {
        "command": "exercicesMpi.resetSheets",
        "key": "escape",
        "when": "focusedView == exercicesMpi.sheets && exercicesMpi.searchActive.sheets && !inputFocus"
      },
      {
        "command": "exercicesMpi.resetContests",
        "key": "escape",
        "when": "focusedView == exercicesMpi.contests && exercicesMpi.searchActive.contests && !inputFocus"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run build && node --test dist/core.test.js",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --out releases/"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "vscode-jsonrpc": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
